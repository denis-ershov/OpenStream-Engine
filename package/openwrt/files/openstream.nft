# OpenStream Engine — ONLY table inet openstream
# Не изменяет inet zapret / inet fw4 / podkop.
# Set openstream_hls наполняется hostlist refresh / dnsmasq nftset.

add table inet openstream

add set inet openstream openstream_hls {
	type ipv4_addr
	flags interval
	comment "Twitch/HLS CDN IPs for transparent divert"
}

add chain inet openstream prerouting {
	type nat hook prerouting priority dstnat - 5
	policy accept
}

# Только HLS CDN IP → local MITM (не весь 443)
add rule inet openstream prerouting tcp dport 443 ip daddr @openstream_hls redirect to :18080
