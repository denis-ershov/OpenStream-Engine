#!/bin/sh
# Собирает /var/run/openstream/hostlist-effective.txt из:
#   - /etc/openstream/hostlists-remote/<svc>.txt (если есть)
#   - иначе /usr/share/openstream/hostlists/<svc>.txt
#   - + UCI list custom_domain
# Сервисы: UCI list proxy.hostlist_services; плюс авто из enabled-плагинов.

set -e

OUT="${1:-/var/run/openstream/hostlist-effective.txt}"
SHIPPED=/usr/share/openstream/hostlists
REMOTE=/etc/openstream/hostlists-remote
TMP="${OUT}.tmp.$$"

mkdir -p "$(dirname "$OUT")" "$REMOTE"

uci_get() {
	uci -q get "openstream.$1" 2>/dev/null
}

# Собираем список сервисов
SERVICES=""
for s in $(uci -q get openstream.proxy.hostlist_services 2>/dev/null); do
	SERVICES="$SERVICES $s"
done

# Авто: включённый плагин → сервис в списке
add_if_enabled() {
	local svc="$1" flag="$2"
	local v
	v="$(uci_get "$flag")"
	case "$v" in
		1|on|true|yes|enabled)
			case " $SERVICES " in
				*" $svc "*) ;;
				*) SERVICES="$SERVICES $svc" ;;
			esac
			;;
	esac
}
add_if_enabled twitch twitch.enabled
add_if_enabled kick kick.enabled
add_if_enabled trovo trovo.enabled
add_if_enabled youtube youtube.enabled

# Если пусто — twitch по умолчанию
[ -n "$(echo "$SERVICES" | tr -d ' \t\n')" ] || SERVICES="twitch"

{
	echo "# generated by openstream-compose-hostlist"
	echo "# do not edit; change UCI / hostlists / custom_domain"
	for svc in $SERVICES; do
		svc="$(echo "$svc" | tr -cd 'a-z0-9_')"
		[ -n "$svc" ] || continue
		f=""
		if [ -f "$REMOTE/$svc.txt" ]; then
			f="$REMOTE/$svc.txt"
		elif [ -f "$SHIPPED/$svc.txt" ]; then
			f="$SHIPPED/$svc.txt"
		fi
		[ -n "$f" ] || continue
		echo "# --- $svc ($f) ---"
		# shellcheck disable=SC2002
		cat "$f" | sed 's/\r$//' | grep -v '^[[:space:]]*$' | grep -v '^[[:space:]]*#' || true
	done
	echo "# --- custom_domain ---"
	for d in $(uci -q get openstream.proxy.custom_domain 2>/dev/null); do
		d="$(echo "$d" | tr -d '\r' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
		[ -n "$d" ] || continue
		case "$d" in
			\#*) continue ;;
		esac
		echo "$d"
	done
} >"$TMP"

mv "$TMP" "$OUT"
echo "$OUT"
