# ==============================================================================
# OpenStream Engine — Git Ignore Rules for Public Repository
# ==============================================================================

# ------------------------------------------------------------------------------
# Rust / Cargo Build Artifacts
# ------------------------------------------------------------------------------
/target/
**/*.rs.bk
*.profraw
*.profdata
.cargo-docker/

# ------------------------------------------------------------------------------
# OpenWrt & Native Binaries / Packages
# ------------------------------------------------------------------------------
package/openwrt/streamproxyd
dist/**/bin/
dist/**/ipk/
dist/**/SHA256SUMS
scripts/bin/
scripts/po2lmo/po2lmo
scripts/po2lmo/*.o
scripts/po2lmo/lib/*.o
scripts/po2lmo/lib/plural_formula.c
scripts/po2lmo/lib/plural_formula.h
scripts/po2lmo/contrib/lemon
*.o
*.a
*.so
*.dylib
*.dll
*.exe
*.pdb

# ------------------------------------------------------------------------------
# Python & Virtual Environments (Autolab / Research)
# ------------------------------------------------------------------------------
__pycache__/
**/*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# Research / Autolab Data & Session Logs
# ------------------------------------------------------------------------------
research/twitch/results/*/
research/twitch/autolab/.venv/
research/twitch/autolab/user_data/
research/twitch/autolab/__pycache__/
*.har
playwright-report/
test-results/

# ------------------------------------------------------------------------------
# Local Configuration & Secrets
# ------------------------------------------------------------------------------
/config.yaml
*.pem
*.key
*.crt
*.pfx
*.p12
*.token
tokens.json
.env
.env.*
!.env.example

# ------------------------------------------------------------------------------
# IDEs, Editors & AI Assistants
# ------------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.cursor/
.claude/
.gemini/
.agents/
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# Operating System Junk
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
desktop.ini

# ------------------------------------------------------------------------------
# Logs & Temporary Files
# ------------------------------------------------------------------------------
*.log
*.tmp
*.bak
scratch/
